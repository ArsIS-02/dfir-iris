# DFIR-IRIS — пример конфигурации. Скопировать в .env и заполнить своими значениями.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_ADMIN_USER=raptor
POSTGRES_ADMIN_PASSWORD=change-me
POSTGRES_DB=iris_db
POSTGRES_SERVER=db
POSTGRES_PORT=5432
DOCKERIZED=1
IRIS_SECRET_KEY=change-me-long-random
IRIS_SECURITY_PASSWORD_SALT=change-me-random
IRIS_UPSTREAM_SERVER=app
IRIS_UPSTREAM_PORT=8000
CELERY_BROKER=amqp://rabbitmq
IRIS_AUTHENTICATION_TYPE=local
INTERFACE_HTTPS_PORT=8101
SERVER_NAME=iris.apps.monitoring.test
CERT_FILENAME=iris_cert.pem
KEY_FILENAME=iris_key.pem
# IRIS_WORKER в .env НЕ задавать: приложение упадёт с "A secret key is required to use CSRF"
