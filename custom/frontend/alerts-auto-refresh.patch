@@ -0,0 +1,38 @@
+import { describe, expect, it } from 'vitest';
+import {
+	ALERTS_AUTO_REFRESH_MS,
+	isAlertEditingTarget,
+	shouldAutoRefreshAlerts
+} from '../alerts-auto-refresh';
+
+describe('shouldAutoRefreshAlerts', () => {
+	const ready = { hidden: false, busy: false, dialogOpen: false, editing: false };
+
+	it('runs every 30 seconds when the queue is idle and visible', () => {
+		expect(ALERTS_AUTO_REFRESH_MS).toBe(30_000);
+		expect(shouldAutoRefreshAlerts(ready)).toBe(true);
+	});
+
+	it.each([
+		['hidden tab', { hidden: true }],
+		['request in flight', { busy: true }],
+		['open dialog', { dialogOpen: true }],
+		['active editor', { editing: true }]
+	])('pauses for a %s', (_name, override) => {
+		expect(shouldAutoRefreshAlerts({ ...ready, ...override })).toBe(false);
+	});
+});
+
+describe('isAlertEditingTarget', () => {
+	it.each(['input', 'textarea', 'select'])('recognises an active %s', (tag) => {
+		expect(isAlertEditingTarget(document.createElement(tag))).toBe(true);
+	});
+
+	it('recognises rich-text editors but not buttons or no selection', () => {
+		const editor = document.createElement('div');
+		editor.setAttribute('contenteditable', 'true');
+		expect(isAlertEditingTarget(editor)).toBe(true);
+		expect(isAlertEditingTarget(document.createElement('button'))).toBe(false);
+		expect(isAlertEditingTarget(null)).toBe(false);
+	});
+});
