@@ -0,0 +1,21 @@
+export const ALERTS_AUTO_REFRESH_MS = 30_000;
+
+type AlertsAutoRefreshState = {
+	hidden: boolean;
+	busy: boolean;
+	dialogOpen: boolean;
+	editing: boolean;
+};
+
+/** Refresh only when it cannot interrupt the analyst or duplicate a request. */
+export const shouldAutoRefreshAlerts = ({
+	hidden,
+	busy,
+	dialogOpen,
+	editing
+}: AlertsAutoRefreshState): boolean => !hidden && !busy && !dialogOpen && !editing;
+
+/** Inputs and rich-text editors keep their unsent content across queue updates. */
+export const isAlertEditingTarget = (target: Element | null): boolean =>
+	target?.matches('input, textarea, select, [contenteditable]:not([contenteditable="false"])') ??
+	false;
