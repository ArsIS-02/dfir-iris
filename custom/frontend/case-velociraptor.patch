+				<p class="-mt-3 text-xs text-muted-foreground">
+					The asset type sets the initial OS. You can change it; TicketBridge verifies it against
+					the live Velociraptor client before creating any Flow.
+				</p>
+
+				<div class="space-y-3 rounded-md border p-4">
+					<div class="flex flex-wrap items-center justify-between gap-2">
+						<div>
+							<Label>Collection artifacts</Label>
+							<p class="mt-1 text-xs text-muted-foreground">
+								{selectedArtifacts.length} selected · maximum {catalog.max_artifacts} per run
+							</p>
+						</div>
+						<div class="flex gap-1">
+							<Button
+								type="button"
+								variant="ghost"
+								size="sm"
+								disabled={busy !== null}
+								onclick={selectRecommended}
+							>
+								Recommended
+							</Button>
+							<Button
+								type="button"
+								variant="ghost"
+								size="sm"
+								disabled={busy !== null}
+								onclick={clearArtifacts}
+							>
+								Clear
+							</Button>
+						</div>
+					</div>
+					<div class="relative">
+						<SearchIcon class="absolute left-3 top-3 size-4 text-muted-foreground" />
+						<Input
+							value={artifactSearch}
+							placeholder="Filter artifacts…"
