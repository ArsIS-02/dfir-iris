+		Loader2Icon,
+		RefreshCwIcon
+	} from 'lucide-svelte';
+	import Button from '$lib/components/ui/button/button.svelte';
+	import {
+		parseVelociraptorJobHistory,
+		velociraptorEvidenceHref,
+		velociraptorIncidentJobsUrl,
+		velociraptorJobIsActive,
+		velociraptorJobStatusClass,
+		velociraptorJobStatusLabel,
+		type VelociraptorJob
+	} from '$lib/utils/velociraptor-jobs';
+
+	type Props = { caseId: number };
+	let { caseId }: Props = $props();
+
+	const jobsEndpoint = '__TB_URL__/velociraptor/jobs?key=__TB_KEY__';
+	let jobs = $state<VelociraptorJob[]>([]);
+	let loading = $state(false);
+	let error = $state('');
+	let loadedCaseId = 0;
+	let requestSequence = 0;
+	let pollTimer: ReturnType<typeof setTimeout> | null = null;
+
+	const clearPoll = () => {
+		if (pollTimer !== null) clearTimeout(pollTimer);
+		pollTimer = null;
+	};
+
+	const load = async (id: number, preserveJobs = true) => {
+		const sequence = ++requestSequence;
+		clearPoll();
+		loading = true;
+		error = '';
+		if (!preserveJobs) jobs = [];
+		try {
+			const response = await fetch(velociraptorIncidentJobsUrl(jobsEndpoint, id), {
+				headers: { Accept: 'application/json' }
+			});
+			const payload = (await response.json().catch(() => null)) as unknown;
+			if (sequence !== requestSequence) return;
+			if (!response.ok) throw new Error(`Collection history returned HTTP ${response.status}`);
+			jobs = parseVelociraptorJobHistory(payload, id);
+			if (jobs.some((job) => velociraptorJobIsActive(job.status))) {
+				pollTimer = setTimeout(() => {
+					if (sequence === requestSequence) void load(id);
+				}, 2000);
+			}
+		} catch (cause) {
+			if (sequence === requestSequence) {
+				error = cause instanceof Error ? cause.message : 'Failed to load Velociraptor jobs';
+			}
+		} finally {
+			if (sequence === requestSequence) loading = false;
+		}
+	};
+
+	$effect(() => {
+		const id = caseId;
+		untrack(() => {
+			if (!Number.isSafeInteger(id) || id <= 0 || id === loadedCaseId) return;
+			loadedCaseId = id;
+			void load(id, false);
+		});
+	});
+
+	onDestroy(() => {
+		requestSequence += 1;
+		clearPoll();
+	});
+</script>
