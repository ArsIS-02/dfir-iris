@@ -0,0 +1,196 @@
+import { describe, expect, it } from 'vitest';
+import {
+	defaultVelociraptorArtifacts,
+	parseVelociraptorCatalog,
+	parseVelociraptorResolvedClient,
+	recommendedVelociraptorArtifacts,
+	validVelociraptorClientId,
+	validVelociraptorSelection,
+	velociraptorClientId,
+	velociraptorResolveClientUrl,
+	withVelociraptorClientId
+} from '../velociraptor';
+
+const CLIENT = 'C.0123456789abcdef';
+
+const catalog = parseVelociraptorCatalog({
+	schema_version: 1,
+	max_artifacts: 8,
+	manual_window_days: 30,
+	platforms: [
+		{
+			id: 'linux',
+			label: 'RED OS / Linux',
+			artifacts: [
+				{
+					name: 'Generic.Client.Info',
+					label: 'Host information',
+					description: 'Host',
+					recommended: true
+				},
+				{
+					name: 'Linux.Sys.Pslist',
+					label: 'Processes',
+					description: 'Processes',
+					recommended: true
+				},
+				{ name: 'Linux.Sys.Users', label: 'Users', description: 'Users', recommended: false }
+			]
+		},
+		{
+			id: 'darwin',
+			label: 'macOS',
+			artifacts: [
+				{
+					name: 'Generic.Client.Info',
+					label: 'Host information',
+					description: 'Host',
+					recommended: true
+				},
+				{ name: 'MacOS.System.Users', label: 'Users', description: 'Users', recommended: false }
+			]
+		},
+		{
+			id: 'windows',
+			label: 'Windows',
+			artifacts: [
+				{
+					name: 'Generic.Client.Info',
+					label: 'Host information',
+					description: 'Host',
+					recommended: true
+				},
+				{
+					name: 'Windows.System.Pslist',
+					label: 'Processes',
+					description: 'Processes',
+					recommended: true
+				}
+			]
+		}
+	]
+});
+
+describe('Velociraptor asset attributes', () => {
+	it('reads the canonical typed client_id', () => {
+		expect(
+			velociraptorClientId({
+				velociraptor: { client_id: { type: 'input_string', value: ` ${CLIENT} ` } }
+			})
+		).toBe(CLIENT);
+	});
+
+	it('accepts legacy tab and field labels with plain values', () => {
+		expect(velociraptorClientId({ Velociraptor: { 'Client ID': CLIENT } })).toBe(CLIENT);
+		expect(velociraptorClientId({ velociraptor: { clientId: CLIENT } })).toBe(CLIENT);
+	});
+
+	it('validates the exact client ID shape', () => {
+		expect(validVelociraptorClientId(CLIENT)).toBe(true);
+		expect(validVelociraptorClientId('C.0123456789ABCDEF')).toBe(false);
+		expect(validVelociraptorClientId('hostname; DELETE')).toBe(false);
+	});
+
+	it('saves a typed attribute without mutating or dropping other values', () => {
+		const original = {
+			existing: { owner: 'soc' },
+			velociraptor: { note: 'keep me' }
+		};
+		const updated = withVelociraptorClientId(original, CLIENT);
+		expect(updated.existing).toEqual({ owner: 'soc' });
+		expect(updated.velociraptor.note).toBe('keep me');
+		expect(updated.velociraptor.client_id).toEqual({ type: 'input_string', value: CLIENT });
+		expect(original.velociraptor).toEqual({ note: 'keep me' });
+	});
+
+	it('rejects invalid input before an asset update can be sent', () => {
+		expect(() => withVelociraptorClientId({}, 'not-a-client')).toThrow('Client ID');
+	});
+});
+
+describe('Velociraptor collection catalog', () => {
+	it('validates multi-selection against the selected operating system', () => {
+		expect(
+			validVelociraptorSelection(catalog, 'linux', ['Generic.Client.Info', 'Linux.Sys.Pslist'])
+		).toBe(true);
+		expect(validVelociraptorSelection(catalog, 'darwin', ['Linux.Sys.Pslist'])).toBe(false);
+		expect(validVelociraptorSelection(catalog, 'windows', ['Custom.Remediation.DeleteFile'])).toBe(
+			false
+		);
+		expect(validVelociraptorSelection(catalog, 'linux', [])).toBe(false);
+		expect(
+			validVelociraptorSelection(catalog, 'linux', ['Linux.Sys.Users', 'Linux.Sys.Users'])
+		).toBe(false);
+		expect(validVelociraptorSelection(catalog, 'linux', Array(9).fill('Linux.Sys.Users'))).toBe(
+			false
+		);
+	});
+
+	it('uses safe defaults and recommended choices per platform', () => {
+		expect(defaultVelociraptorArtifacts(catalog, 'linux')).toEqual(['Generic.Client.Info']);
+		expect(recommendedVelociraptorArtifacts(catalog, 'linux')).toEqual([
+			'Generic.Client.Info',
+			'Linux.Sys.Pslist'
+		]);
+		expect(recommendedVelociraptorArtifacts(catalog, 'windows')).toEqual([
+			'Generic.Client.Info',
+			'Windows.System.Pslist'
+		]);
+	});
+
+	it('rejects malformed catalogs and remediation entries', () => {
+		expect(() => parseVelociraptorCatalog(null)).toThrow('invalid artifact catalog');
+		const tampered = JSON.parse(JSON.stringify(catalog));
+		tampered.platforms[0].artifacts[0].name = 'Custom.Remediation.DeleteFile';
+		expect(() => parseVelociraptorCatalog(tampered)).toThrow('Invalid or duplicate artifact');
+	});
+});
+
+describe('Velociraptor client resolver', () => {
+	it('builds same-origin resolver URLs and preserves absolute endpoints', () => {
+		expect(
+			velociraptorResolveClientUrl(
+				'/velociraptor/resolve-client?key=test',
+				'host name.example.test',
+				'https://iris.example.test'
+			)
+		).toBe(
+			'https://iris.example.test/velociraptor/resolve-client?key=test&hostname=host+name.example.test'
+		);
+		expect(
+			velociraptorResolveClientUrl(
+				'https://ticketbridge.example.test/velociraptor/resolve-client?key=test',
+				'host.example.test',
+				'https://iris.example.test'
+			)
+		).toBe(
+			'https://ticketbridge.example.test/velociraptor/resolve-client?key=test&hostname=host.example.test'
+		);
+	});
+
+	it('accepts only a valid resolved client and supported live platform', () => {
+		expect(
+			parseVelociraptorResolvedClient({
+				ok: true,
+				client_id: ` ${CLIENT} `,
+				platform: 'linux',
+				hostname: 'server-01',
+				fqdn: 'server-01.example.test'
+			})
+		).toEqual({
+			clientId: CLIENT,
+			platform: 'linux',
+			hostname: 'server-01',
+			fqdn: 'server-01.example.test'
+		});
+	});
+
+	it.each([
+		null,
+		{ ok: false, client_id: CLIENT, platform: 'linux' },
+		{ ok: true, client_id: 'not-a-client', platform: 'linux' },
+		{ ok: true, client_id: CLIENT, platform: 'solaris' }
+	])('rejects a malformed resolver response: %j', (payload) => {
+		expect(() => parseVelociraptorResolvedClient(payload)).toThrow('invalid');
+	});
+});
diff --git a/src/lib/utils/velociraptor-jobs.ts b/src/lib/utils/velociraptor-jobs.ts
new file mode 100644
index 0000000..bc5701d
--- /dev/null
+++ b/src/lib/utils/velociraptor-jobs.ts
@@ -0,0 +1,174 @@
+export const VELOCIRAPTOR_ACTIVE_JOB_STATUSES = ['queued', 'collecting', 'uploading'] as const;
+
+export const VELOCIRAPTOR_JOB_STATUSES = [
+	...VELOCIRAPTOR_ACTIVE_JOB_STATUSES,
+	'completed',
+	'partial',
+	'failed',
+	'evidence_error',
+	'error'
+] as const;
+
+export type VelociraptorJobStatus = (typeof VELOCIRAPTOR_JOB_STATUSES)[number];
+
+export type VelociraptorJobFlow = {
+	artifact: string;
+	flowId: string;
+	flowLink: string;
+	state: string;
+	rowCount: number;
+};
+
+export type VelociraptorJob = {
+	jobId: string;
+	kind: 'alert' | 'case';
+	targetId: number;
+	caseId: number;
+	platform: string;
+	status: VelociraptorJobStatus;
+	createdTs: number;
+	updatedTs: number;
+	error: string;
+	flows: VelociraptorJobFlow[];
+	evidenceId: number | null;
+	filename: string;
+	sha256: string;
+	size: number | null;
+};
+
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+	typeof value === 'object' && value !== null && !Array.isArray(value);
+
+const requiredString = (value: unknown): string => {
+	if (typeof value !== 'string' || !value.trim()) {
+		throw new Error('TicketBridge returned an invalid collection job');
+	}
+	return value.trim();
+};
+
+const positiveInteger = (value: unknown): number => {
+	const parsed = Number(value);
+	if (!Number.isSafeInteger(parsed) || parsed <= 0) {
+		throw new Error('TicketBridge returned an invalid collection job target');
+	}
+	return parsed;
+};
+
+const optionalPositiveInteger = (value: unknown): number | null => {
+	if (value === null || value === undefined || value === '') return null;
+	return positiveInteger(value);
+};
+
+const finiteTimestamp = (value: unknown): number => {
+	const parsed = Number(value);
+	if (!Number.isFinite(parsed) || parsed <= 0) {
+		throw new Error('TicketBridge returned an invalid collection job timestamp');
+	}
+	return parsed;
+};
+
+export const safeVelociraptorHttpUrl = (value: unknown): string => {
+	const raw = requiredString(value);
+	let parsed: URL;
+	try {
+		parsed = new URL(raw);
+	} catch {
+		throw new Error('TicketBridge returned an invalid Flow URL');
+	}
+	if (parsed.protocol !== 'https:' && parsed.protocol !== 'http:') {
+		throw new Error('TicketBridge returned a non-HTTP Flow URL');
+	}
+	return parsed.toString();
+};
+
+export const velociraptorIncidentJobsUrl = (endpoint: string, caseId: number): string =>
+	`${endpoint}${endpoint.includes('?') ? '&' : '?'}incident_id=${positiveInteger(caseId)}`;
+
+export const velociraptorEvidenceHref = (caseId: number, evidenceId: number): string =>
+	`/case/${positiveInteger(caseId)}/evidence/${positiveInteger(evidenceId)}`;
+
+export const velociraptorJobIsActive = (status: VelociraptorJobStatus): boolean =>
+	(VELOCIRAPTOR_ACTIVE_JOB_STATUSES as readonly string[]).includes(status);
+
+export const velociraptorJobStatusLabel = (status: VelociraptorJobStatus): string =>
+	({
+		queued: 'Queued',
+		collecting: 'Collecting',
+		uploading: 'Uploading Evidence',
+		completed: 'Completed',
+		partial: 'Partial',
+		failed: 'Failed',
+		evidence_error: 'Evidence delivery error',
+		error: 'Error'
+	})[status];
+
+export const velociraptorJobStatusClass = (status: VelociraptorJobStatus): string => {
+	if (status === 'completed')
+		return 'border-emerald-600/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400';
+	if (status === 'partial')
+		return 'border-amber-600/30 bg-amber-500/10 text-amber-700 dark:text-amber-400';
+	if (velociraptorJobIsActive(status))
+		return 'border-sky-600/30 bg-sky-500/10 text-sky-700 dark:text-sky-400';
+	return 'border-destructive/40 bg-destructive/10 text-destructive';
+};
+
+const parseFlow = (value: unknown): VelociraptorJobFlow => {
+	if (!isRecord(value)) throw new Error('TicketBridge returned an invalid Flow');
+	return {
+		artifact: requiredString(value.artifact),
+		flowId: requiredString(value.flow_id),
+		flowLink: safeVelociraptorHttpUrl(value.flow_link),
+		state: typeof value.state === 'string' ? value.state : '',
+		rowCount: Number.isFinite(Number(value.row_count)) ? Number(value.row_count) : 0
+	};
+};
+
+const parseJob = (value: unknown, expectedCaseId: number): VelociraptorJob => {
+	if (!isRecord(value)) throw new Error('TicketBridge returned an invalid collection job');
+	const jobId = requiredString(value.job_id);
+	if (!/^[0-9a-f]{32}$/.test(jobId)) throw new Error('TicketBridge returned an invalid Job ID');
+	if (value.kind !== 'alert' && value.kind !== 'case') {
+		throw new Error('TicketBridge returned an invalid collection job kind');
+	}
+	const status = requiredString(value.status) as VelociraptorJobStatus;
+	if (!(VELOCIRAPTOR_JOB_STATUSES as readonly string[]).includes(status)) {
+		throw new Error('TicketBridge returned an unknown collection job status');
+	}
+	const caseId = positiveInteger(value.case_id);
+	if (caseId !== expectedCaseId)
+		throw new Error('TicketBridge returned a job for another incident');
+	const result = isRecord(value.result) ? value.result : null;
+	const size = result?.size === null || result?.size === undefined ? null : Number(result.size);
+	if (size !== null && (!Number.isFinite(size) || size < 0)) {
+		throw new Error('TicketBridge returned an invalid Evidence size');
+	}
+	return {
+		jobId,
+		kind: value.kind,
+		targetId: positiveInteger(value.target_id),
+		caseId,
+		platform: typeof value.platform === 'string' ? value.platform : '',
+		status,
+		createdTs: finiteTimestamp(value.created_ts),
+		updatedTs: finiteTimestamp(value.updated_ts),
+		error: typeof value.error === 'string' ? value.error : '',
+		flows: result && Array.isArray(result.artifacts) ? result.artifacts.map(parseFlow) : [],
+		evidenceId: optionalPositiveInteger(result?.evidence_id),
+		filename: typeof result?.filename === 'string' ? result.filename : '',
+		sha256: typeof result?.sha256 === 'string' ? result.sha256 : '',
+		size
+	};
+};
+
+export const parseVelociraptorJobHistory = (
+	payload: unknown,
+	caseId: number
+): VelociraptorJob[] => {
+	const expectedCaseId = positiveInteger(caseId);
+	if (!isRecord(payload) || payload.ok !== true || !Array.isArray(payload.jobs)) {
+		throw new Error('TicketBridge returned an invalid collection history');
+	}
+	return payload.jobs
+		.map((job) => parseJob(job, expectedCaseId))
+		.sort((left, right) => right.createdTs - left.createdTs);
+};
diff --git a/src/lib/utils/velociraptor.ts b/src/lib/utils/velociraptor.ts
new file mode 100644
index 0000000..4a83dcf
--- /dev/null
+++ b/src/lib/utils/velociraptor.ts
@@ -0,0 +1,210 @@
+export const VELOCIRAPTOR_CLIENT_ID_RE = /^C\.[0-9a-f]{16}$/;
+export const VELOCIRAPTOR_DEFAULT_ARTIFACT = 'Generic.Client.Info';
+
+export type VelociraptorPlatformId = 'linux' | 'darwin' | 'windows';
+
+export type VelociraptorArtifact = {
+	name: string;
+	label: string;
+	description: string;
+	recommended: boolean;
+};
+
+export type VelociraptorPlatform = {
+	id: VelociraptorPlatformId;
+	label: string;
+	artifacts: VelociraptorArtifact[];
+};
+
+export type VelociraptorCatalog = {
+	schema_version: 1;
+	max_artifacts: number;
+	manual_window_days: number;
+	platforms: VelociraptorPlatform[];
+};
+
+export type AssetCustomAttributes = Record<string, Record<string, unknown>> | null | undefined;
+
+const isRecord = (value: unknown): value is Record<string, unknown> =>
+	typeof value === 'object' && value !== null && !Array.isArray(value);
+
+/** Validate the server-provided allowlist before using it in the dialog. */
+export const parseVelociraptorCatalog = (value: unknown): VelociraptorCatalog => {
+	if (!isRecord(value) || value.schema_version !== 1 || !Array.isArray(value.platforms)) {
+		throw new Error('TicketBridge returned an invalid artifact catalog');
+	}
+	const maxArtifacts = Number(value.max_artifacts);
+	const windowDays = Number(value.manual_window_days);
+	if (!Number.isInteger(maxArtifacts) || maxArtifacts < 1 || maxArtifacts > 100) {
+		throw new Error('TicketBridge returned an invalid artifact limit');
+	}
+	if (!Number.isInteger(windowDays) || windowDays < 1 || windowDays > 365) {
+		throw new Error('TicketBridge returned an invalid collection window');
+	}
+	const platformIds = new Set<string>();
+	const platforms = value.platforms.map((rawPlatform) => {
+		if (
+			!isRecord(rawPlatform) ||
+			!['linux', 'darwin', 'windows'].includes(String(rawPlatform.id))
+		) {
+			throw new Error('TicketBridge returned an unknown collection platform');
+		}
+		const id = String(rawPlatform.id) as VelociraptorPlatformId;
+		if (platformIds.has(id) || typeof rawPlatform.label !== 'string' || !rawPlatform.label) {
+			throw new Error('TicketBridge returned a duplicate or unlabeled platform');
+		}
+		platformIds.add(id);
+		if (!Array.isArray(rawPlatform.artifacts) || rawPlatform.artifacts.length === 0) {
+			throw new Error(`TicketBridge returned no artifacts for ${id}`);
+		}
+		const names = new Set<string>();
+		const artifacts = rawPlatform.artifacts.map((rawArtifact) => {
+			if (!isRecord(rawArtifact)) throw new Error('Invalid artifact catalog entry');
+			const name = String(rawArtifact.name ?? '');
+			if (
+				!/^[A-Za-z][A-Za-z0-9_.]+$/.test(name) ||
+				names.has(name) ||
+				name.startsWith('Custom.Remediation.') ||
+				typeof rawArtifact.label !== 'string' ||
+				!rawArtifact.label ||
+				typeof rawArtifact.description !== 'string' ||
+				typeof rawArtifact.recommended !== 'boolean'
+			) {
+				throw new Error(`Invalid or duplicate artifact in catalog: ${name || 'unknown'}`);
+			}
+			names.add(name);
+			return {
+				name,
+				label: rawArtifact.label,
+				description: rawArtifact.description,
+				recommended: rawArtifact.recommended
+			};
+		});
+		return { id, label: rawPlatform.label, artifacts };
+	});
+	if (platformIds.size !== 3)
+		throw new Error('TicketBridge catalog must contain all three platforms');
+	return {
+		schema_version: 1,
+		max_artifacts: maxArtifacts,
+		manual_window_days: windowDays,
+		platforms
+	};
+};
+
+export const velociraptorPlatform = (
+	catalog: VelociraptorCatalog,
+	platform: string
+): VelociraptorPlatform | null => catalog.platforms.find((item) => item.id === platform) ?? null;
+
+export const defaultVelociraptorArtifacts = (
+	catalog: VelociraptorCatalog,
+	platform: string
+): string[] => {
+	const artifacts = velociraptorPlatform(catalog, platform)?.artifacts ?? [];
+	return artifacts.some((item) => item.name === VELOCIRAPTOR_DEFAULT_ARTIFACT)
+		? [VELOCIRAPTOR_DEFAULT_ARTIFACT]
+		: artifacts
+				.filter((item) => item.recommended)
+				.slice(0, 1)
+				.map((item) => item.name);
+};
+
+export const recommendedVelociraptorArtifacts = (
+	catalog: VelociraptorCatalog,
+	platform: string
+): string[] =>
+	(velociraptorPlatform(catalog, platform)?.artifacts ?? [])
+		.filter((item) => item.recommended)
+		.map((item) => item.name);
+
+export const validVelociraptorSelection = (
+	catalog: VelociraptorCatalog,
+	platform: string,
+	selected: string[]
+): boolean => {
+	if (selected.length === 0 || selected.length > catalog.max_artifacts) return false;
+	if (new Set(selected).size !== selected.length) return false;
+	const allowed = new Set(
+		(velociraptorPlatform(catalog, platform)?.artifacts ?? []).map((item) => item.name)
+	);
+	return selected.every((name) => allowed.has(name));
+};
+
+const attributeValue = (value: unknown): string => {
+	const unwrapped = isRecord(value) && 'value' in value ? value.value : value;
+	return typeof unwrapped === 'string' ? unwrapped.trim() : '';
+};
+
+/** Read the ID from a case asset; tolerate legacy labels and plain values. */
+export const velociraptorClientId = (attributes: AssetCustomAttributes): string => {
+	for (const tabName of ['velociraptor', 'Velociraptor']) {
+		const tab = attributes?.[tabName];
+		if (!isRecord(tab)) continue;
+		for (const fieldName of ['client_id', 'Client ID', 'clientId']) {
+			const value = attributeValue(tab[fieldName]);
+			if (value) return value;
+		}
+	}
+	return '';
+};
+
+export const validVelociraptorClientId = (value: string): boolean =>
+	VELOCIRAPTOR_CLIENT_ID_RE.test(value.trim());
+
+export type VelociraptorResolvedClient = {
+	clientId: string;
+	platform: VelociraptorPlatformId;
+	hostname: string;
+	fqdn: string;
+};
+
+export const velociraptorResolveClientUrl = (
+	endpoint: string,
+	hostname: string,
+	origin: string
+): string => {
+	const url = new URL(endpoint, origin);
+	url.searchParams.set('hostname', hostname);
+	return url.toString();
+};
+
+/** Validate the read-only server resolver response before filling the dialog. */
+export const parseVelociraptorResolvedClient = (value: unknown): VelociraptorResolvedClient => {
+	if (!isRecord(value) || value.ok !== true) {
+		throw new Error('TicketBridge returned an invalid client resolution');
+	}
+	const clientId = typeof value.client_id === 'string' ? value.client_id.trim() : '';
+	const platform = String(value.platform ?? '');
+	if (
+		!validVelociraptorClientId(clientId) ||
+		!['linux', 'darwin', 'windows'].includes(platform)
+	) {
+		throw new Error('TicketBridge returned an invalid resolved client');
+	}
+	return {
+		clientId,
+		platform: platform as VelociraptorPlatformId,
+		hostname: typeof value.hostname === 'string' ? value.hostname : '',
+		fqdn: typeof value.fqdn === 'string' ? value.fqdn : ''
+	};
+};
+
+/** Store the typed representation used by IRIS; preserve all other values. */
+export const withVelociraptorClientId = (
+	attributes: AssetCustomAttributes,
+	clientId: string
+): Record<string, Record<string, unknown>> => {
+	const normalized = clientId.trim();
+	if (!validVelociraptorClientId(normalized)) {
+		throw new Error('Velociraptor Client ID must match C.<16 lowercase hex characters>');
+	}
+	const currentTab = isRecord(attributes?.velociraptor) ? attributes.velociraptor : {};
+	return {
+		...(attributes ?? {}),
+		velociraptor: {
+			...currentTab,
+			client_id: { type: 'input_string', value: normalized }
+		}
+	};
+};
