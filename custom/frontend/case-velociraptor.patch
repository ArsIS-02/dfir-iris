+						>
+							{velociraptorJobStatusLabel(job.status)}
+						</span>
+						<span class="text-muted-foreground">
+							{job.kind === 'alert' ? `From alert #${job.targetId}` : 'From this incident'}
+							{#if job.platform}
+								· {job.platform}{/if}
+						</span>
+						<time
+							class="ml-auto text-muted-foreground"
+							datetime={new Date(job.createdTs * 1000).toISOString()}
+						>
+							{new Date(job.createdTs * 1000).toLocaleString()}
+						</time>
+					</div>
+
+					<div class="break-all font-mono text-[11px] text-muted-foreground">
+						Job ID: <span class="select-all text-foreground">{job.jobId}</span>
+					</div>
+
+					{#if job.flows.length > 0}
+						<div class="flex flex-wrap gap-x-3 gap-y-1">
+							{#each job.flows as flow (flow.flowId)}
+								<a
+									class="inline-flex items-center gap-1 break-all text-primary underline"
+									href={flow.flowLink}
+									target="_blank"
+									rel="noopener noreferrer"
+								>
+									{flow.artifact} · {flow.flowId}
+									{#if flow.state}
+										· {flow.state}{/if} · {flow.rowCount} rows
+									<ExternalLinkIcon size={11} class="shrink-0" />
+								</a>
+							{/each}
+						</div>
+					{/if}
+
+					{#if job.evidenceId}
+						<div class="flex flex-wrap items-center gap-x-2 gap-y-1">
+							<Button
+								variant="outline"
