+						</p>
+					{:else}
+						<p class="text-xs text-muted-foreground">
+							A saved ID is read from custom attributes → velociraptor → client_id; otherwise
+							TicketBridge finds it by hostname/FQDN. You can override it for this collection{alertId ===
+							undefined
+								? ' or save it separately to the selected asset.'
+								: '; alert assets are read-only here.'}
+						</p>
+					{/if}
+				</div>
+
+				<label class="flex cursor-pointer items-start gap-3 text-sm" for="velociraptor-confirm">
+					<input
+						id="velociraptor-confirm"
+						type="checkbox"
+						class="mt-1 size-4"
+						checked={confirmed}
+						disabled={busy !== null ||
+							resolving ||
+							!selectedAsset ||
+							!validClientId ||
+							!validSelection}
+						onchange={(event) => {
+							confirmed = event.currentTarget.checked;
+							error = '';
+						}}
+						data-testid="velociraptor-confirm"
