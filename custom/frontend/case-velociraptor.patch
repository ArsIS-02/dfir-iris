+	import { AlertService } from '$lib/services/alerts.service';
+	import type { Asset } from '$lib/types/resources/asset';
+	import {
+		CASE_ASSETS_CTX,
+		type CaseAssetsContext
+	} from '$lib/contexts/case-assets.context.svelte';
+	import {
+		CASE_EVIDENCES_CTX,
+		type CaseEvidencesContext
+	} from '$lib/contexts/case-evidences.context.svelte';
+	import {
+		defaultVelociraptorArtifacts,
+		parseVelociraptorCatalog,
+		parseVelociraptorResolvedClient,
+		recommendedVelociraptorArtifacts,
+		validVelociraptorClientId,
+		validVelociraptorSelection,
+		velociraptorClientId,
+		velociraptorResolveClientUrl,
+		velociraptorPlatform,
+		withVelociraptorClientId,
+		type VelociraptorCatalog,
+		type VelociraptorPlatformId
+	} from '$lib/utils/velociraptor';
+
+	type Props = {
+		open: boolean;
+		caseId?: number;
+		alertId?: number;
+		onCollected?: (caseId: number) => void;
+	};
+
+	type CollectionFlow = {
+		artifact: string;
+		flow_id: string;
+		flow_link: string;
+		state: string;
+		row_count: number;
+	};
+
+	type CollectionError = {
+		artifact: string;
+		error: string;
+	};
+
+	type CollectionResult = {
+		status: 'completed' | 'partial' | 'failed';
+		platform: VelociraptorPlatformId;
+		batch_id: string;
+		requested_artifacts: string[];
+		artifacts: CollectionFlow[];
+		errors: CollectionError[];
+		evidence_id: number | string;
+		sha256: string;
+		case_id: number;
+		case_created?: boolean;
+		asset_id?: number | null;
+	};
+
+	type CollectionJob = {
+		job_id: string;
+		status:
+			| 'queued'
+			| 'collecting'
+			| 'uploading'
+			| 'completed'
+			| 'partial'
+			| 'failed'
+			| 'evidence_error'
+			| 'error';
+		case_id: number | null;
+		error: string | null;
+		result: CollectionResult | null;
+	};
+
+	let { open = $bindable(), caseId, alertId, onCollected }: Props = $props();
+
+	const caseAssets = getContext<CaseAssetsContext | undefined>(CASE_ASSETS_CTX);
+	const caseEvidences = getContext<CaseEvidencesContext | undefined>(CASE_EVIDENCES_CTX);
+	const endpoint =
+		alertId !== undefined
+			? '__TB_URL__/velociraptor/alert-collect?key=__TB_KEY__'
+			: '__TB_URL__/velociraptor/collect?key=__TB_KEY__';
+	const catalogEndpoint = '__TB_URL__/velociraptor/catalog?key=__TB_KEY__';
+	const resolveClientEndpoint = '__TB_URL__/velociraptor/resolve-client?key=__TB_KEY__';
+	const jobsEndpoint = '__TB_URL__/velociraptor/jobs?key=__TB_KEY__';
+	const jobEndpoint = (jobId: string) => `__TB_URL__/velociraptor/jobs/${jobId}?key=__TB_KEY__`;
+
+	let assets = $state<Asset[]>([]);
+	let catalog = $state<VelociraptorCatalog | null>(null);
+	let selectedAssetId = $state('');
+	let selectedPlatform = $state<VelociraptorPlatformId>('linux');
+	let selectedArtifacts = $state<string[]>([]);
+	let artifactSearch = $state('');
+	let clientId = $state('');
+	let clientIdSource = $state<'asset' | 'velociraptor' | 'manual' | ''>('');
+	let resolving = $state(false);
+	let confirmed = $state(false);
+	let busy = $state<'load' | 'save' | 'collect' | null>(null);
+	let error = $state('');
+	let result = $state<CollectionResult | null>(null);
+	let jobStatus = $state<CollectionJob['status'] | ''>('');
+	let activeJobId = $state('');
+	let resolvedCaseId = $state<number | null>(caseId ?? null);
+	let loadSequence = 0;
+	let resolveSequence = 0;
+	let pollSequence = 0;
+
+	const selectedAsset = $derived(
+		assets.find((asset) => String(asset.asset_id) === selectedAssetId) ?? null
+	);
+	const currentPlatform = $derived(
+		catalog ? velociraptorPlatform(catalog, selectedPlatform) : null
+	);
+	const filteredArtifacts = $derived.by(() => {
+		const query = artifactSearch.trim().toLowerCase();
+		const artifacts = currentPlatform?.artifacts ?? [];
+		if (!query) return artifacts;
+		return artifacts.filter((artifact) =>
+			`${artifact.name} ${artifact.label}`.toLowerCase().includes(query)
+		);
+	});
+	const validClientId = $derived(validVelociraptorClientId(clientId));
+	const validSelection = $derived(
+		catalog ? validVelociraptorSelection(catalog, selectedPlatform, selectedArtifacts) : false
+	);
+
+	const resetConfirmation = () => {
+		confirmed = false;
+		error = '';
+		result = null;
+	};
+
+	const platformForAsset = (asset: Asset | null): VelociraptorPlatformId => {
+		const typeId = Number(asset?.asset_type_id ?? 0);
+		if (typeId === 6) return 'darwin';
+		if (typeId === 9 || typeId === 11) return 'windows';
+		return 'linux';
+	};
+
+	const selectPlatform = (platform: VelociraptorPlatformId, preserveResult = false) => {
+		if (!catalog) return;
+		selectedPlatform = platform;
+		selectedArtifacts = defaultVelociraptorArtifacts(catalog, platform);
+		artifactSearch = '';
+		if (preserveResult) {
+			confirmed = false;
+			error = '';
+		} else {
+			resetConfirmation();
+		}
+	};
+
+	const resolveClientForAsset = async (asset: Asset, sequence: number) => {
+		resolving = true;
+		error = '';
+		try {
+			const url = velociraptorResolveClientUrl(
+				resolveClientEndpoint,
+				asset.asset_name,
+				window.location.origin
+			);
+			const response = await fetch(url, { headers: { Accept: 'application/json' } });
+			const raw = (await response.json().catch(() => null)) as unknown;
+			if (!response.ok) {
+				const message =
+					typeof raw === 'object' && raw !== null && 'error' in raw && typeof raw.error === 'string'
+						? raw.error
+						: `Client resolver returned HTTP ${response.status}`;
+				throw new Error(message);
+			}
+			const resolved = parseVelociraptorResolvedClient(raw);
+			if (sequence !== resolveSequence || selectedAssetId !== String(asset.asset_id)) return;
+			// A slow resolver must not erase a completed job restored in parallel.
+			selectPlatform(resolved.platform, true);
+			clientId = resolved.clientId;
+			clientIdSource = 'velociraptor';
+		} catch (cause) {
+			if (sequence === resolveSequence) {
+				error = `Automatic Client ID lookup failed: ${cause instanceof Error ? cause.message : 'unknown resolver error'}`;
+			}
+		} finally {
+			if (sequence === resolveSequence) resolving = false;
+		}
+	};
+
+	const selectAsset = (assetId: number | string) => {
+		selectedAssetId = String(assetId);
+		const sequence = ++resolveSequence;
+		resolving = false;
+		const asset = assets.find((item) => String(item.asset_id) === selectedAssetId) ?? null;
+		clientId = asset ? velociraptorClientId(asset.custom_attributes) : '';
+		clientIdSource = validVelociraptorClientId(clientId) ? 'asset' : '';
+		selectPlatform(platformForAsset(asset));
+		if (asset && clientIdSource !== 'asset') void resolveClientForAsset(asset, sequence);
+	};
+
+	const toggleArtifact = (artifact: string, checked: boolean) => {
+		if (!catalog || !currentPlatform?.artifacts.some((item) => item.name === artifact)) return;
+		if (checked && !selectedArtifacts.includes(artifact)) {
+			if (selectedArtifacts.length >= catalog.max_artifacts) {
+				resetConfirmation();
+				error = `Select no more than ${catalog.max_artifacts} artifacts per run`;
+				return;
+			}
+			selectedArtifacts = [...selectedArtifacts, artifact];
+		} else if (!checked) {
+			selectedArtifacts = selectedArtifacts.filter((item) => item !== artifact);
+		}
+		resetConfirmation();
+	};
+
+	const selectRecommended = () => {
+		if (!catalog) return;
+		selectedArtifacts = recommendedVelociraptorArtifacts(catalog, selectedPlatform);
+		resetConfirmation();
+	};
+
+	const clearArtifacts = () => {
+		selectedArtifacts = [];
+		resetConfirmation();
+	};
+
+	const parseJob = (payload: unknown): CollectionJob | null => {
+		if (typeof payload !== 'object' || payload === null || !('job' in payload)) {
+			throw new Error('TicketBridge returned an invalid collection job response');
+		}
+		const job = payload.job as CollectionJob | null;
+		if (job === null) return null;
+		if (!job || !/^[0-9a-f]{32}$/.test(job.job_id) || !job.status) {
+			throw new Error('TicketBridge returned an invalid collection job');
+		}
+		return job;
+	};
+
+	const finishJob = (job: CollectionJob, notify: boolean) => {
+		if (job.case_id && job.case_id > 0) resolvedCaseId = job.case_id;
+		if (job.status === 'error' || job.status === 'evidence_error') {
+			throw new Error(job.error || `Collection finished with status ${job.status}`);
+		}
+		const completed = job.result;
+		if (
+			!completed ||
+			completed.status !== job.status ||
+			!completed.sha256 ||
+			!completed.evidence_id ||
+			!(completed.case_id > 0) ||
+			!Array.isArray(completed.requested_artifacts) ||
+			!Array.isArray(completed.artifacts) ||
+			!Array.isArray(completed.errors) ||
+			completed.artifacts.some(
+				(flow) =>
+					!completed.requested_artifacts.includes(flow.artifact) || !flow.flow_id || !flow.flow_link
+			)
+		) {
+			throw new Error('TicketBridge returned an incomplete collection result');
+		}
+		result = completed;
+		resolvedCaseId = completed.case_id;
+		confirmed = false;
+		busy = null;
+		activeJobId = '';
+		if (notify) {
+			toast({
+				title:
+					completed.status === 'completed'
+						? 'Velociraptor collection finished'
+						: 'Collection finished with errors',
+				description: `Incident #${completed.case_id}, Evidence #${completed.evidence_id}; ${completed.artifacts.length} succeeded, ${completed.errors.length} failed`,
+				variant: completed.status === 'failed' ? 'destructive' : 'success'
+			});
+			onCollected?.(completed.case_id);
+			if (caseEvidences) void caseEvidences.refresh();
+		}
+	};
+
+	const pollJob = async (jobId: string) => {
+		const sequence = ++pollSequence;
+		activeJobId = jobId;
+		busy = 'collect';
+		try {
+			while (sequence === pollSequence) {
+				const response = await fetch(jobEndpoint(jobId), {
+					headers: { Accept: 'application/json' }
+				});
+				const payload = (await response.json().catch(() => null)) as unknown;
+				if (sequence !== pollSequence) return;
+				if (!response.ok) throw new Error(`Collection status returned HTTP ${response.status}`);
+				const job = parseJob(payload);
+				if (!job) throw new Error('Collection job disappeared');
+				jobStatus = job.status;
+				if (job.case_id && job.case_id > 0) resolvedCaseId = job.case_id;
+				if (['queued', 'collecting', 'uploading'].includes(job.status)) {
+					await new Promise((resolve) => setTimeout(resolve, 1500));
+					continue;
+				}
+				finishJob(job, true);
+				return;
+			}
+		} catch (cause) {
+			if (sequence === pollSequence) {
+				error = cause instanceof Error ? cause.message : 'Velociraptor collection failed';
+				busy = null;
+				activeJobId = '';
+			}
+		}
+	};
+
+	const loadLatestJob = async (sequence: number) => {
+		const selector = alertId !== undefined ? `alert_id=${alertId}` : `case_id=${caseId}`;
+		const response = await fetch(`${jobsEndpoint}&${selector}`, {
+			headers: { Accept: 'application/json' }
+		});
+		const payload = (await response.json().catch(() => null)) as unknown;
+		if (sequence !== loadSequence) return;
+		if (!response.ok) throw new Error(`Collection history returned HTTP ${response.status}`);
+		const job = parseJob(payload);
+		if (!job) return;
+		jobStatus = job.status;
+		if (['queued', 'collecting', 'uploading'].includes(job.status)) {
+			void pollJob(job.job_id);
+		} else if (job.status === 'error' || job.status === 'evidence_error') {
+			if (job.case_id && job.case_id > 0) resolvedCaseId = job.case_id;
+			error = job.error || `Previous collection finished with status ${job.status}`;
+		} else {
+			finishJob(job, false);
+		}
+	};
+
+	const loadAssets = async () => {
+		const sequence = ++loadSequence;
+		resolveSequence += 1;
+		resolving = false;
+		clientIdSource = '';
+		busy = 'load';
+		error = '';
+		result = null;
+		resolvedCaseId = caseId ?? null;
+		confirmed = false;
+		try {
+			const catalogResponse = await fetch(catalogEndpoint, {
+				headers: { Accept: 'application/json' }
+			});
+			const rawCatalog = (await catalogResponse.json().catch(() => null)) as unknown;
+			if (!catalogResponse.ok)
+				throw new Error(`Artifact catalog returned HTTP ${catalogResponse.status}`);
+			const parsedCatalog = parseVelociraptorCatalog(rawCatalog);
+			let loadedAssets: Asset[];
+			if (alertId !== undefined) {
+				const response = await AlertService.get(alertId);
+				if (!response.ok || response.error || !response.data || typeof response.data === 'string') {
+					throw new Error(response.error?.message ?? 'Failed to load alert assets');
+				}
+				loadedAssets = response.data.assets ?? [];
+				resolvedCaseId = response.data.cases?.[0] ?? null;
+			} else if (caseId !== undefined) {
+				const response = await CaseAssetsService.list(caseId, {
+					page: 1,
+					per_page: 1000,
+					order_by: 'asset_id',
+					sort_dir: 'asc'
+				});
+				if (!response.ok || response.error || !response.data || typeof response.data === 'string') {
+					throw new Error(response.error?.message ?? 'Failed to load case assets');
+				}
+				loadedAssets = response.data.data;
+			} else {
+				throw new Error('A case or alert must be selected');
+			}
+			if (sequence !== loadSequence) return;
+			catalog = parsedCatalog;
+			assets = loadedAssets;
+			const preferred =
+				assets.find((asset) =>
+					validVelociraptorClientId(velociraptorClientId(asset.custom_attributes))
+				) ?? assets[0];
+			if (preferred) selectAsset(preferred.asset_id);
+			else {
+				selectedAssetId = '';
+				clientId = '';
+				selectPlatform('linux');
+			}
+			await loadLatestJob(sequence);
+		} catch (cause) {
+			if (sequence === loadSequence) {
+				error = cause instanceof Error ? cause.message : 'Failed to load collection options';
+			}
+		} finally {
+			if (sequence === loadSequence && busy === 'load') busy = null;
+		}
+	};
+
+	const saveClientId = async () => {
+		if (!selectedAsset) {
+			error = 'Select a case asset first';
+			return;
+		}
+		let customAttributes;
+		try {
+			customAttributes = withVelociraptorClientId(selectedAsset.custom_attributes, clientId);
+		} catch (cause) {
+			error = cause instanceof Error ? cause.message : 'Invalid Client ID';
+			return;
+		}
+
+		busy = 'save';
+		error = '';
+		try {
+			if (caseId === undefined) throw new Error('Client ID can be saved from a case asset');
+			const response = await CaseAssetsService.update(caseId, selectedAsset.asset_id, {
+				custom_attributes: customAttributes
+			});
+			if (!response.ok || response.error || !response.data || typeof response.data === 'string') {
+				throw new Error(response.error?.message ?? 'Failed to update the asset');
+			}
+			const updated = response.data;
+			assets = assets.map((asset) => (asset.asset_id === updated.asset_id ? updated : asset));
+			if (caseAssets) caseAssets.byId[updated.asset_id] = updated;
+			clientId = velociraptorClientId(updated.custom_attributes) || clientId.trim();
+			clientIdSource = 'asset';
+			toast({
+				title: 'Velociraptor Client ID saved',
+				description: `Asset: ${updated.asset_name}`,
+				variant: 'success'
+			});
+		} catch (cause) {
+			error = cause instanceof Error ? cause.message : 'Failed to update the case asset';
+		} finally {
+			busy = null;
+		}
+	};
+
+	const collect = async () => {
+		if (!selectedAsset) {
+			error = 'Select a case asset first';
+			return;
+		}
+		if (!validClientId) {
+			error = 'Enter a valid Client ID: C.<16 lowercase hex characters>';
+			return;
+		}
+		if (!catalog || !validSelection) {
+			error = 'Select at least one allowed artifact for the chosen operating system';
+			return;
+		}
+		if (!confirmed) {
+			error = 'Explicit confirmation is required before collection';
+			return;
+		}
+
+		busy = 'collect';
+		error = '';
+		result = null;
+		jobStatus = 'queued';
+		try {
+			const body = new URLSearchParams({
+				asset_id: String(selectedAsset.asset_id),
+				client_id: clientId.trim(),
+				platform: selectedPlatform,
+				confirm: 'yes',
+				response: 'json',
+				async: '1'
+			});
+			if (alertId !== undefined) body.set('alert_id', String(alertId));
+			else if (caseId !== undefined) body.set('case_id', String(caseId));
+			else throw new Error('A case or alert must be selected');
+			for (const artifact of selectedArtifacts) body.append('artifacts', artifact);
+			const response = await fetch(endpoint, {
+				method: 'POST',
+				headers: {
+					Accept: 'application/json',
+					'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8'
+				},
+				body
+			});
+			const payload = (await response.json().catch(() => null)) as {
+				ok?: boolean;
+				error?: string;
+				job?: CollectionJob;
+			} | null;
+			if (!response.ok || !payload?.ok) {
+				throw new Error(payload?.error ?? `TicketBridge returned HTTP ${response.status}`);
+			}
+			const job = parseJob(payload);
+			if (!job) throw new Error('TicketBridge did not return a collection job');
+			if (job.case_id && job.case_id > 0) resolvedCaseId = job.case_id;
+			confirmed = false;
+			await pollJob(job.job_id);
+		} catch (cause) {
+			error = cause instanceof Error ? cause.message : 'Velociraptor collection failed';
+			busy = null;
+			activeJobId = '';
+		}
+	};
+
+	$effect(() => {
+		const isOpen = open;
+		untrack(() => {
+			if (isOpen) {
+				if (busy === null) void loadAssets();
+			} else {
+				loadSequence += 1;
+				resolveSequence += 1;
+				pollSequence += 1;
+				resolving = false;
+				confirmed = false;
+				error = '';
+				jobStatus = '';
+				activeJobId = '';
+				if (busy === 'load' || busy === 'collect') busy = null;
+				if (busy === null) result = null;
+			}
+		});
+	});
+</script>
+
+<Dialog.Root bind:open>
+	<Dialog.Content class="flex max-h-[92vh] max-w-[760px] flex-col gap-0 overflow-hidden p-0">
+		<Dialog.Header class="shrink-0 border-b px-6 py-4">
+			<Dialog.Title class="flex items-center gap-2 text-base font-medium">
+				<HardDriveUploadIcon class="size-4" /> Collect with Velociraptor
+			</Dialog.Title>
+			<Dialog.Description>
+				Choose an operating system and one or more reviewed artifacts. Separate Flows run in the
+				background and are packaged into one verified Evidence ZIP.{alertId !== undefined
+					? ' A linked incident is reused or created automatically.'
+					: ''}
+			</Dialog.Description>
+		</Dialog.Header>
+
+		<div class="min-h-0 flex-1 space-y-5 overflow-y-auto px-6 py-5">
+			{#if busy === 'load'}
+				<div class="flex items-center gap-2 text-sm text-muted-foreground">
+					<Loader2Icon class="size-4 animate-spin" /> Loading assets and the server-approved catalog…
+				</div>
+			{:else if assets.length === 0}
+				<div class="rounded-md border border-dashed p-4 text-sm text-muted-foreground">
+					Add a host to the {alertId !== undefined ? 'alert' : 'case'} assets first. Its Velociraptor
+					Client ID can then be stored in custom attributes.
+				</div>
+			{:else if catalog}
+				<div class="grid gap-4 sm:grid-cols-2">
+					<div class="space-y-2">
+						<Label for="velociraptor-asset">{alertId !== undefined ? 'Alert' : 'Case'} asset</Label>
+						<select
+							id="velociraptor-asset"
+							class="h-10 w-full rounded-md border border-input bg-background px-3 text-sm"
+							value={selectedAssetId}
+							disabled={busy !== null}
+							onchange={(event) => selectAsset(event.currentTarget.value)}
+							data-testid="velociraptor-asset"
+						>
+							{#each assets as asset (asset.asset_id)}
+								<option value={String(asset.asset_id)}>
+									{asset.asset_name}{validVelociraptorClientId(
+										velociraptorClientId(asset.custom_attributes)
+									)
+										? ' — Client ID saved'
+										: ''}
