@@ -0,0 +1,45 @@
+import { describe, expect, it } from 'vitest';
+import {
+	validVelociraptorClientId,
+	velociraptorClientId,
+	withVelociraptorClientId
+} from '../velociraptor';
+
+const CLIENT = 'C.0123456789abcdef';
+
+describe('Velociraptor asset attributes', () => {
+	it('reads the canonical typed client_id', () => {
+		expect(
+			velociraptorClientId({
+				velociraptor: { client_id: { type: 'input_string', value: ` ${CLIENT} ` } }
+			})
+		).toBe(CLIENT);
+	});
+
+	it('accepts legacy tab and field labels with plain values', () => {
+		expect(velociraptorClientId({ Velociraptor: { 'Client ID': CLIENT } })).toBe(CLIENT);
+		expect(velociraptorClientId({ velociraptor: { clientId: CLIENT } })).toBe(CLIENT);
+	});
+
+	it('validates the exact client ID shape', () => {
+		expect(validVelociraptorClientId(CLIENT)).toBe(true);
+		expect(validVelociraptorClientId('C.0123456789ABCDEF')).toBe(false);
+		expect(validVelociraptorClientId('hostname; DELETE')).toBe(false);
+	});
+
+	it('saves a typed attribute without mutating or dropping other values', () => {
+		const original = {
+			existing: { owner: 'soc' },
+			velociraptor: { note: 'keep me' }
+		};
+		const updated = withVelociraptorClientId(original, CLIENT);
+		expect(updated.existing).toEqual({ owner: 'soc' });
+		expect(updated.velociraptor.note).toBe('keep me');
+		expect(updated.velociraptor.client_id).toEqual({ type: 'input_string', value: CLIENT });
+		expect(original.velociraptor).toEqual({ note: 'keep me' });
+	});
+
+	it('rejects invalid input before an asset update can be sent', () => {
+		expect(() => withVelociraptorClientId({}, 'not-a-client')).toThrow('Client ID');
+	});
+});
