+					</div>
+
+					<div class="space-y-2">
+						<Label for="velociraptor-platform">Operating system</Label>
+						<select
+							id="velociraptor-platform"
+							class="h-10 w-full rounded-md border border-input bg-background px-3 text-sm"
+							value={selectedPlatform}
+							disabled={busy !== null}
+							onchange={(event) =>
+								selectPlatform(event.currentTarget.value as VelociraptorPlatformId)}
+							data-testid="velociraptor-platform"
+						>
+							{#each catalog.platforms as platform (platform.id)}
