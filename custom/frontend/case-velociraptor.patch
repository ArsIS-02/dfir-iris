@@ -0,0 +1,86 @@
+import { describe, expect, it } from 'vitest';
+import {
+	parseVelociraptorJobHistory,
+	safeVelociraptorHttpUrl,
+	velociraptorEvidenceHref,
+	velociraptorIncidentJobsUrl,
+	velociraptorJobIsActive,
+	velociraptorJobStatusLabel
+} from '../velociraptor-jobs';
+
+const job = (id: string, createdTs: number, kind: 'alert' | 'case' = 'alert') => ({
+	job_id: id,
+	kind,
+	target_id: kind === 'alert' ? 1431 : 90,
+	case_id: 90,
+	platform: 'linux',
+	status: 'completed',
+	created_ts: createdTs,
+	updated_ts: createdTs + 2,
+	error: '',
+	result: {
+		artifacts: [
+			{
+				artifact: 'Generic.Client.Info',
+				flow_id: 'F.TEST',
+				flow_link: 'https://velociraptor.example.test/flows/F.TEST',
+				state: 'FINISHED',
+				row_count: 22
+			}
+		],
+		evidence_id: 114,
+		filename: 'case-90-test.zip',
+		sha256: 'abc123',
+		size: 3362
+	}
+});
+
+describe('Velociraptor incident job history', () => {
+	it('parses alert and incident jobs and sorts the newest first', () => {
+		const jobs = parseVelociraptorJobHistory(
+			{ ok: true, jobs: [job('a'.repeat(32), 100, 'case'), job('b'.repeat(32), 200)] },
+			90
+		);
+		expect(jobs.map((item) => item.jobId)).toEqual(['b'.repeat(32), 'a'.repeat(32)]);
+		expect(jobs[0].flows[0]).toMatchObject({ flowId: 'F.TEST', rowCount: 22 });
+		expect(jobs[0].evidenceId).toBe(114);
+	});
+
+	it('accepts an empty history without creating a placeholder job', () => {
+		expect(parseVelociraptorJobHistory({ ok: true, jobs: [] }, 90)).toEqual([]);
+	});
+
+	it('rejects malformed, cross-incident and unsafe responses', () => {
+		expect(() => parseVelociraptorJobHistory({ ok: true }, 90)).toThrow(
+			'invalid collection history'
+		);
+		expect(() =>
+			parseVelociraptorJobHistory(
+				{ ok: true, jobs: [{ ...job('a'.repeat(32), 100), case_id: 91 }] },
+				90
+			)
+		).toThrow('another incident');
+		const unsafe = job('a'.repeat(32), 100);
+		unsafe.result.artifacts[0].flow_link = 'javascript:alert(1)';
+		expect(() => parseVelociraptorJobHistory({ ok: true, jobs: [unsafe] }, 90)).toThrow('Flow URL');
+	});
+
+	it('builds only local Evidence links and preserves the endpoint key', () => {
+		expect(velociraptorIncidentJobsUrl('/velociraptor/jobs?key=test', 90)).toBe(
+			'/velociraptor/jobs?key=test&incident_id=90'
+		);
+		expect(velociraptorEvidenceHref(90, 114)).toBe('/case/90/evidence/114');
+		expect(safeVelociraptorHttpUrl('http://velociraptor.example.test/F.TEST')).toBe(
+			'http://velociraptor.example.test/F.TEST'
+		);
+	});
+
+	it('polls only active jobs and keeps terminal status labels explicit', () => {
+		expect(velociraptorJobIsActive('queued')).toBe(true);
+		expect(velociraptorJobIsActive('collecting')).toBe(true);
+		expect(velociraptorJobIsActive('uploading')).toBe(true);
+		expect(velociraptorJobIsActive('completed')).toBe(false);
+		expect(velociraptorJobIsActive('evidence_error')).toBe(false);
+		expect(velociraptorJobStatusLabel('evidence_error')).toBe('Evidence delivery error');
+	});
+});
diff --git a/src/lib/utils/__tests__/velociraptor.test.ts b/src/lib/utils/__tests__/velociraptor.test.ts
