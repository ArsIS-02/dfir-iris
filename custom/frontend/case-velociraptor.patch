+						<p class="flex items-center gap-2 text-xs text-muted-foreground">
+							<Loader2Icon class="size-3 animate-spin" /> Finding one unique normalized hostname/FQDN
+							match in Velociraptor…
+						</p>
+					{:else if clientIdSource === 'velociraptor'}
+						<p class="text-xs text-muted-foreground">
+							Found automatically by an unique normalized hostname/FQDN match. Verify the client
+							before collection{alertId === undefined
+								? '; use Save to asset to persist it.'
