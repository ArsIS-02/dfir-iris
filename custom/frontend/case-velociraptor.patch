+			>
+				{error}
+			</p>
+		{/if}
+
+		<div class="divide-y divide-border/50">
+			{#each jobs.slice(0, 3) as job (job.jobId)}
+				<article
+					class="space-y-2 px-3 py-2.5 text-xs"
+					data-testid={`velociraptor-job-${job.jobId}`}
+				>
+					<div class="flex flex-wrap items-center gap-x-2 gap-y-1">
+						<span
