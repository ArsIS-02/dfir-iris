+				</div>
+
+				<div class="space-y-2">
+					<div class="flex items-center justify-between gap-3">
+						<Label for="velociraptor-client-id">Velociraptor Client ID</Label>
+						{#if alertId === undefined}
+							<Button
+								type="button"
+								variant="ghost"
+								size="sm"
+								disabled={busy !== null || resolving || !validClientId}
