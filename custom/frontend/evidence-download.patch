@@ -0,0 +1,32 @@
+import { describe, expect, it } from 'vitest';
+import { evidenceDownloadLabel, findEvidenceDatastoreFile } from '../evidence-download';
+
+const datastoreFile = (file_sha256: string | null, file_is_evidence = true) => ({
+	file_sha256,
+	file_is_evidence
+});
+
+describe('Evidence datastore download', () => {
+	it('matches the source file by SHA-256 rather than numeric object IDs', () => {
+		const files = [datastoreFile('AA-BB'), datastoreFile('cc-dd')];
+
+		expect(findEvidenceDatastoreFile(files, { file_hash: 'CC-DD' })).toBe(files[1]);
+	});
+
+	it('requires a datastore file explicitly marked as evidence', () => {
+		const files = [datastoreFile('AA-BB', false)];
+
+		expect(findEvidenceDatastoreFile(files, { file_hash: 'aa-bb' })).toBeNull();
+	});
+
+	it('does not offer a download without a confirmed hash match', () => {
+		expect(findEvidenceDatastoreFile([datastoreFile('AA-BB')], { file_hash: null })).toBeNull();
+		expect(findEvidenceDatastoreFile([datastoreFile(null)], { file_hash: 'AA-BB' })).toBeNull();
+		expect(findEvidenceDatastoreFile([], { file_hash: 'AA-BB' })).toBeNull();
+	});
+
+	it('labels ZIP downloads explicitly and preserves other file types', () => {
+		expect(evidenceDownloadLabel('case-90-triage.ZIP')).toBe('Download ZIP');
+		expect(evidenceDownloadLabel('timeline.csv')).toBe('Download file');
+	});
+});
