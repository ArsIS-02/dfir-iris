@@ -0,0 +1,28 @@
+import type { Evidence } from '$lib/types/resources/evidence';
+import type { DataStoreFile } from '$lib/types/resources/datastore';
+
+type EvidenceIdentity = Pick<Evidence, 'file_hash'>;
+type DatastoreFileIdentity = Pick<DataStoreFile, 'file_sha256' | 'file_is_evidence'>;
+
+/**
+ * Evidence registry IDs and datastore file IDs are independent. The backend
+ * links an imported evidence to its source by SHA-256, so never assume that
+ * equal numeric IDs identify the same object.
+ */
+export const findEvidenceDatastoreFile = <T extends DatastoreFileIdentity>(
+	files: T[],
+	evidence: EvidenceIdentity | null | undefined
+): T | null => {
+	const expectedHash = evidence?.file_hash?.trim().toLowerCase();
+	if (!expectedHash) return null;
+
+	return (
+		files.find(
+			(file) =>
+				file.file_is_evidence === true && file.file_sha256?.trim().toLowerCase() === expectedHash
+		) ?? null
+	);
+};
+
+export const evidenceDownloadLabel = (filename: string): string =>
+	filename.trim().toLowerCase().endsWith('.zip') ? 'Download ZIP' : 'Download file';
